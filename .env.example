# Copy this file to .env and replace every placeholder before deployment.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=production
TRUST_PROXY_HOPS=0

SMTP_HOST=0.0.0.0
SMTP_PORT=25
# SMTP 对外主机名应有 A/AAAA 及 PTR；容器内路径通常放在 /app/data 下。
SMTP_HOSTNAME=mail.yourdomain.com
# 配齐证书后填写 data/tls/fullchain.pem 与 data/tls/privkey.pem；空值保持明文收件。
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=
VERIFY_INBOUND=true
# 配齐 DNS、TLS、DKIM 和 TCP 25 出口后开启；每个邮箱仍需主管理员单独授权。
OUTBOUND_ENABLED=false
DKIM_KEY_DIR=data/dkim
DKIM_SELECTOR=maildrop
OUTBOUND_IPV4_ONLY=true
WEB_BIND_HOST=127.0.0.1

# 仅在首次启动（域名表为空）时导入，之后在管理后台「域名设置」中维护；多个域名用逗号分隔，第一个为默认域名。
DOMAINS=yourdomain.com
PASSWORD=your_secure_password_here
PROTECTED_ADDRESSES=^admin.*

DATABASE_PATH=data/mailbox.db
EMAIL_RETENTION_DAYS=7
MAILBOX_RETENTION_DAYS=30
MAX_RETENTION_DAYS=36500
MAX_EMAILS_PER_ADDRESS=50
MAX_MAILBOX_SIZE_MB=100
MAX_EMAIL_SIZE_MB=20

ENABLE_IP_WHITELIST=false
IP_WHITELIST=127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8
ENABLE_SENDER_WHITELIST=false
IP_BLOCK_DURATION=300
IP_MAX_FAILED_ATTEMPTS=3
IP_ATTEMPT_WINDOW=60
